---

---

<footer class="bg-forest-900 text-forest-200 py-12 mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="text-2xl">🐘</span>
          <span
            class="font-[Outfit] font-bold text-forest-300 text-lg"
            >Myanmar ECBT Network</span
          >
        </div>
        <p
          class="text-sm text-forest-300 leading-relaxed lang-en-only"
        >
          A national network of Elephant Conservation Based Tourism camps,
          preserving Myanmar's magnificent Asian elephants while supporting
          local communities.
        </p>
        <p
          class="text-sm text-forest-300 leading-relaxed lang-my-only font-myanmar"
        >
          မြန်မာနိုင်ငံ၏ ဆင်ထိန်းသိမ်းရေးအခြေပြု ခရီးသွားလုပ်ငန်း
          အမျိုးသားကွန်ရက်
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="font-semibold text-forest-300 mb-3 lang-en-only">
          Quick Links
        </h3>
        <h3
          class="font-semibold text-forest-300 mb-3 lang-my-only font-myanmar"
        >
          လင့်များ
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="/"
              class="hover:text-amber-400 transition-colors"
            >
              <span class="lang-en-only">Home</span>
              <span class="lang-my-only font-myanmar">မူလစာမျက်နှာ</span>
            </a>
          </li>
          <li>
            <a
              href="/#camps"
              class="hover:text-amber-400 transition-colors"
            >
              <span class="lang-en-only">All Camps</span>
              <span class="lang-my-only font-myanmar">စခန်းများ</span>
            </a>
          </li>
          <li>
            <a
              href="/#about"
              class="hover:text-amber-400 transition-colors"
            >
              <span class="lang-en-only">About</span>
              <span class="lang-my-only font-myanmar">အကြောင်း</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Ministry credit -->
      <div>
        <h3 class="font-semibold text-forest-300 mb-3 lang-en-only">
          Ministry
        </h3>
        <h3
          class="font-semibold text-forest-300 mb-3 lang-my-only font-myanmar"
        >
          ဝန်ကြီးဌာန
        </h3>
        <p
          class="text-sm text-forest-300 leading-relaxed lang-en-only"
        >
          Ministry of Natural Resources and Environmental Conservation<br />
          Myanma Timber Enterprise
        </p>
        <p
          class="text-sm text-forest-300 leading-relaxed lang-my-only font-myanmar"
        >
          သဘာဝသယံဇာတနှင့် သဘာဝပတ်ဝန်းကျင် ထိန်းသိမ်းရေးဝန်ကြီးဌာန
        </p>
      </div>
    </div>

    <div
      class="border-t border-forest-700 pt-6 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-forest-400"
    >
      <span
        >© {new Date().getFullYear()} Myanmar ECBT Network. All rights reserved.</span
      >
      <span class="lang-en-only"
        >Built with love for elephant conservation 🐘</span
      >
      <span class="lang-my-only font-myanmar"
        >ဆင်ထိန်းသိမ်းရေးအတွက် ချစ်မြတ်နိုးလျက် 🐘</span
      >
    </div>
  </div>
</footer>
