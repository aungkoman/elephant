---
interface Activity {
  label: string;
  icon: string;
}

const ACTIVITY_MAP: Record<string, Activity> = {
  'Elephant Riding':   { label: 'Elephant Riding',   icon: '🐘' },
  'Elephant Bathing':  { label: 'Elephant Bathing',   icon: '🛁' },
  'Elephant Show':     { label: 'Elephant Show',      icon: '🎪' },
  'Elephant Feeding':  { label: 'Elephant Feeding',   icon: '🌿' },
  'Elephant Buffet':   { label: 'Elephant Buffet',    icon: '🎋' },
  'Photography':       { label: 'Photography',        icon: '📷' },
  'Video Recording':   { label: 'Video Recording',    icon: '🎬' },
  'Jungle Walk':       { label: 'Jungle Walk',        icon: '🌳' },
  'Trekking':          { label: 'Trekking',           icon: '🥾' },
  'Boat':              { label: 'Boat Trip',           icon: '⛵' },
  'Rafting':           { label: 'Rafting',             icon: '🚣' },
  'Wedding':           { label: 'Wedding',             icon: '💐' },
  'Pre Wedding':       { label: 'Pre-Wedding',         icon: '💍' },
  'Conservation':      { label: 'Conservation',        icon: '🌱' },
  'Souvenir':          { label: 'Souvenirs',           icon: '🛍️' },
  'Restaurant':        { label: 'Restaurant',          icon: '🍽️' },
  'Relax':             { label: 'Relaxation',          icon: '🧘' },
};

interface Props {
  activity: string;
  size?: 'sm' | 'md';
}

const { activity, size = 'md' } = Astro.props;
const info = ACTIVITY_MAP[activity] ?? { label: activity, icon: '✨' };
---

<span
  class={`inline-flex items-center gap-1.5 rounded-full font-medium whitespace-nowrap border border-[--color-forest-300]/30
    ${size === 'sm'
      ? 'px-2 py-0.5 text-xs bg-[--color-forest-100] text-[--color-forest-700]'
      : 'px-3 py-1 text-sm bg-[--color-forest-50] text-[--color-forest-800]'
    }`}
>
  <span aria-hidden="true">{info.icon}</span>
  <span>{info.label}</span>
</span>
