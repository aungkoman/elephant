---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ActivityBadge from '../../components/ActivityBadge.astro';
import PricingTable from '../../components/PricingTable.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';

export async function getStaticPaths() {
  const campsDir = join(process.cwd(), 'src/content/camps');
  const files = readdirSync(campsDir)
    .filter(f => f.endsWith('.json') && f !== '001.json');
  return files.map(f => {
    const camp = JSON.parse(readFileSync(join(campsDir, f), 'utf-8'));
    return { params: { slug: camp.slug }, props: { camp } };
  });
}



const { camp } = Astro.props;

const elephantCount = camp.elephants?.total ?? (
  (camp.elephants?.male ?? 0) + (camp.elephants?.female ?? 0)
) || null;

const GRADIENTS = [
  ['#1a3a2a', '#2e6b4f'],
  ['#1a2e3a', '#2e4f6b'],
  ['#3a1a1a', '#6b2e2e'],
  ['#2a1a3a', '#4f2e6b'],
  ['#1a3a30', '#2e6b5a'],
  ['#3a2e1a', '#6b562e'],
];
const [g1, g2] = GRADIENTS[camp.name_en.charCodeAt(0) % GRADIENTS.length];

const pageDescription = `Visit ${camp.name_en} in ${camp.region ?? 'Myanmar'} — elephant conservation camp offering ${(camp.activities ?? []).slice(0, 3).join(', ')} and more.`;
---

<BaseLayout title={camp.name_en} description={pageDescription} campSlug={camp.slug}>

  <!-- ─── HERO ─────────────────────────────────────────────────────────── -->
  <section
    class="relative min-h-[55vh] flex items-end overflow-hidden pt-20"
    style={camp.images && camp.images.length > 0 ? `background-image: url('${camp.images[0]}'); background-size: cover; background-position: center;` : `background: linear-gradient(135deg, ${g1} 0%, ${g2} 100%)`}
  >
    <!-- Decorative -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none select-none">
      {camp.images && camp.images.length > 0 && (
        <div class="absolute inset-0 bg-black/50"></div>
      )}
      <div class="absolute right-8 top-1/2 -translate-y-1/2 text-[14rem] opacity-[0.07] leading-none">🐘</div>
      <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-white/5 blur-3xl"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 w-full">
      <!-- Breadcrumb -->
      <nav class="mb-6 text-sm text-white/60 flex items-center gap-2">
        <a href="/" class="hover:text-white transition-colors lang-en-only">Home</a>
        <a href="/" class="hover:text-white transition-colors lang-my-only font-myanmar">မူလ</a>
        <span>›</span>
        <a href="/#camps" class="hover:text-white transition-colors lang-en-only">All Camps</a>
        <a href="/#camps" class="hover:text-white transition-colors lang-my-only font-myanmar">စခန်းများ</a>
        <span>›</span>
        <span class="text-white/80">{camp.name_en}</span>
      </nav>

      <!-- Region + ministry chips -->
      <div class="flex flex-wrap gap-2 mb-4">
        {camp.region && (
          <span class="px-3 py-1 rounded-full text-xs font-semibold bg-white/15 text-white">
            📍 {camp.region}
          </span>
        )}
        {camp.ministry && (
          <span class="px-3 py-1 rounded-full text-xs font-semibold bg-white/15 text-white lang-en-only">
            🏛️ Ministry of NREC
          </span>
        )}
      </div>

      <h1 class="font-[Outfit] font-extrabold text-4xl md:text-6xl text-white mb-3 leading-tight lang-en-only">
        {camp.name_en}
      </h1>
      <h1 class="font-extrabold text-3xl md:text-5xl text-white mb-3 leading-tight lang-my-only font-myanmar">
        {camp.name_my ?? camp.name_en}
      </h1>

      <!-- Quick stats pills -->
      <div class="flex flex-wrap gap-3 mt-4">
        {elephantCount && (
          <span class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-black/40 text-white text-sm font-medium backdrop-blur-sm border border-white/20">
            🐘 <span class="lang-en-only">{elephantCount} Elephants</span>
            <span class="lang-my-only font-myanmar">{elephantCount} ဆင်</span>
          </span>
        )}
        {camp.hours && (
          <span class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-black/40 text-white text-sm font-medium backdrop-blur-sm border border-white/20">
            🕐 {camp.hours}
          </span>
        )}
        {camp.fees?.entrance_local_mmk && (
          <span class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-black/50 text-[--color-amber-300] text-sm font-semibold backdrop-blur-sm border border-[--color-amber-500]/40">
            🎟️ {camp.fees.entrance_local_mmk.toLocaleString()} MMK
          </span>
        )}

      </div>
    </div>
  </section>

  <!-- ─── MAIN CONTENT ──────────────────────────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

      <!-- Left column -->
      <div class="lg:col-span-2 space-y-10">

        <!-- Description (from 001.json rich data) -->
        {camp.description_en && (
          <div>
            <h2 class="font-[Outfit] font-bold text-2xl text-[--color-forest-900] mb-4 lang-en-only">
              📖 About This Camp
            </h2>
            <h2 class="font-bold text-2xl text-[--color-forest-900] mb-4 lang-my-only font-myanmar">
              📖 စခန်းအကြောင်း
            </h2>
            <p class="text-[--color-forest-700] leading-relaxed text-base lang-en-only">
              {camp.description_en}
            </p>
            {camp.description_my && (
              <p class="text-[--color-forest-700] leading-relaxed text-base lang-my-only font-myanmar">
                {camp.description_my}
              </p>
            )}
          </div>
        )}

        <!-- Activities -->
        {(camp.activities ?? []).length > 0 && (
          <div>
            <h2 class="font-[Outfit] font-bold text-2xl text-[--color-forest-900] mb-4 lang-en-only">
              🌟 Activities
            </h2>
            <h2 class="font-bold text-2xl text-[--color-forest-900] mb-4 lang-my-only font-myanmar">
              🌟 လှုပ်ရှားမှုများ
            </h2>
            <div class="flex flex-wrap gap-2">
              {camp.activities.map((a: string) => <ActivityBadge activity={a} />)}
            </div>
          </div>
        )}

        <!-- Services (from 001.json) -->
        {camp.services_en && camp.services_en.length > 0 && (
          <div>
            <h2 class="font-[Outfit] font-bold text-2xl text-[--color-forest-900] mb-4 lang-en-only">
              ✨ Services & Highlights
            </h2>
            <h2 class="font-bold text-2xl text-[--color-forest-900] mb-4 lang-my-only font-myanmar">
              ✨ ဝန်ဆောင်မှုများ
            </h2>
            <ul class="space-y-2 lang-en-only">
              {camp.services_en.map((s: string) => (
                <li class="flex items-start gap-2 text-[--color-forest-700]">
                  <span class="text-[--color-forest-500] mt-0.5">✔</span> {s}
                </li>
              ))}
            </ul>
            {camp.services_my && (
              <ul class="space-y-2 lang-my-only font-myanmar">
                {camp.services_my.map((s: string) => (
                  <li class="flex items-start gap-2 text-[--color-forest-700]">
                    <span class="text-[--color-forest-500] mt-0.5">✔</span> {s}
                  </li>
                ))}
              </ul>
            )}
          </div>
        )}


        <!-- Pricing -->
        <div>
          <h2 class="font-[Outfit] font-bold text-2xl text-[--color-forest-900] mb-4 lang-en-only">
            💰 Fees & Pricing
          </h2>
          <h2 class="font-bold text-2xl text-[--color-forest-900] mb-4 lang-my-only font-myanmar">
            💰 ကြေးနှုန်းများ
          </h2>
          <PricingTable fees={camp.fees ?? {}} />
        </div>

        <!-- Map -->
        {camp.latitude && camp.longitude && (
          <div>
            <h2 class="font-[Outfit] font-bold text-2xl text-[--color-forest-900] mb-4 lang-en-only">
              🗺️ Location
            </h2>
            <h2 class="font-bold text-2xl text-[--color-forest-900] mb-4 lang-my-only font-myanmar">
              🗺️ တည်နေရာ
            </h2>
            <MapEmbed lat={camp.latitude} lon={camp.longitude} campName={camp.name_en} />
            <p class="text-xs text-[--color-forest-400] mt-2">
              📍 {camp.latitude.toFixed(5)}, {camp.longitude.toFixed(5)}
            </p>
          </div>
        )}

        <!-- Gallery -->
        {camp.images && camp.images.length > 1 && (
          <div class="mt-12">
            <h2 class="font-[Outfit] font-bold text-2xl text-[--color-forest-900] mb-4 lang-en-only">
              📸 Gallery
            </h2>
            <h2 class="font-bold text-2xl text-[--color-forest-900] mb-4 lang-my-only font-myanmar">
              📸 ဓာတ်ပုံများ
            </h2>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
              {camp.images.slice(1, 10).map((img: string) => (
                <a href={img} target="_blank" rel="noopener noreferrer" class="block aspect-video overflow-hidden rounded-xl bg-forest-50 hover:opacity-90 transition-opacity">
                  <img src={img} alt={`${camp.name_en} Image`} class="w-full h-full object-cover" loading="lazy" />
                </a>
              ))}
            </div>
            {camp.images.length > 10 && (
              <p class="text-sm text-forest-500 mt-4 italic lang-en-only">
                Showing 9 of {camp.images.length - 1} gallery photos.
              </p>
            )}
          </div>
        )}


      </div>

      <!-- Right sidebar -->
      <div class="space-y-6">

        <!-- Info card -->
        <div class="bg-white rounded-3xl border border-[--color-forest-100] shadow-sm p-6 space-y-4">
          <h3 class="font-[Outfit] font-bold text-lg text-[--color-forest-900] lang-en-only">Camp Details</h3>
          <h3 class="font-bold text-lg text-[--color-forest-900] lang-my-only font-myanmar">စခန်းအချက်အလက်</h3>

          {[
            { icon: '📍', labelEn: 'Region', labelMy: 'ဒေသ', value: camp.region },
            { icon: '🕐', labelEn: 'Opening Hours', labelMy: 'ဖွင့်ချိန်', value: camp.hours },
            { icon: '📐', labelEn: 'Camp Area', labelMy: 'မြေဧရိယာ', value: camp.area },
            {
              icon: '🐘', labelEn: 'Elephants', labelMy: 'ဆင်အရေအတွက်',
              value: elephantCount
                ? `${elephantCount} total${camp.elephants?.male ? ` (${camp.elephants.male}♂ · ${camp.elephants.female ?? '?'}♀)` : ''}`
                : null
            },
            { icon: '🏛️', labelEn: 'Under', labelMy: 'အုပ်ချုပ်မှုအောက်', value: camp.ministry ? 'Ministry of NREC' : null },
          ].filter(r => r.value).map(row => (
            <div class="flex items-start gap-3 py-2 border-b border-[--color-forest-50] last:border-0">
              <span class="text-xl">{row.icon}</span>
              <div class="flex-1 min-w-0">
                <div class="text-xs text-[--color-forest-400] lang-en-only">{row.labelEn}</div>
                <div class="text-xs text-[--color-forest-400] lang-my-only font-myanmar">{row.labelMy}</div>
                <div class="text-sm font-medium text-[--color-forest-800] mt-0.5 leading-snug">{row.value}</div>
              </div>
            </div>
          ))}
        </div>

        <!-- Contact card -->
        {(camp.contacts?.length > 0 || camp.facebook) && (
          <div class="bg-forest-900 rounded-3xl p-6 space-y-4 shadow-sm">
            <h3 class="font-[Outfit] font-bold text-lg text-white lang-en-only">📞 Contact</h3>
            <h3 class="font-bold text-lg text-white lang-my-only font-myanmar">📞 ဆက်သွယ်ရန်</h3>

            {camp.contacts?.length > 0 && (
              <div class="space-y-2">
                {camp.contacts.slice(0, 4).map((phone: string) => (
                  <a
                    href={`tel:${phone}`}
                    class="flex items-center gap-2 text-sm text-forest-200 hover:text-amber-300 transition-colors"
                  >
                    <span>📱</span> {phone}
                  </a>
                ))}
              </div>
            )}

            {camp.facebook && (
              <a
                href={camp.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 text-sm text-forest-200 hover:text-amber-300 transition-colors break-all"
              >
                <span>👍</span>
                <span class="lang-en-only">Facebook Page</span>
                <span class="lang-my-only font-myanmar">ဖေ့ဘုတ်</span>
              </a>
            )}
          </div>
        )}


        <!-- Back button -->
        <a
          href="/#camps"
          class="flex items-center justify-center gap-2 w-full py-3 rounded-2xl border-2 border-[--color-forest-300] text-[--color-forest-700] font-semibold hover:bg-[--color-forest-800] hover:text-white hover:border-transparent transition-all duration-200"
        >
          ← <span class="lang-en-only">Back to All Camps</span>
          <span class="lang-my-only font-myanmar">စခန်းများဆီပြန်</span>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
